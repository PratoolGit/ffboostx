<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground. 108x108 viewport with the mark kept inside the
    central 72dp safe zone so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Faint hexagonal plate, echoing the app's card borders. -->
    <path
        android:pathData="M54,22 L79,36 L79,72 L54,86 L29,72 L29,36 Z"
        android:fillColor="#FF6B2C"
        android:fillAlpha="0.14"
        android:strokeColor="#FF6B2C"
        android:strokeAlpha="0.55"
        android:strokeWidth="2" />

    <!-- Bolt -->
    <path
        android:pathData="M60,29 L41,59 L53,59 L47,80 L69,49 L56,49 Z"
        android:fillColor="#FF8A3D" />
</vector>
