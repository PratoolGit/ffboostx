<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Every permission here is used by code in this app, and none of them is a
        privileged, signature or development permission. There is no root, ADB,
        Shizuku or superuser path anywhere in the project.
    -->

    <!-- Reads the active transport and link estimate shown on the dashboard. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Opens the sockets used by the latency and DNS probes. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Appop. Lets the user grant brightness and screen-timeout control. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Appop. Draws the HUD and crosshair over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Appop, granted in Settings. Lets the overlay close itself when the game exits. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Foreground services: the overlay and the background network blocker. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- Shows the ongoing notification that both services are required to post. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Package visibility for Android 11+. Only the two games the app can launch
        are declared; QUERY_ALL_PACKAGES is deliberately not requested.
    -->
    <queries>
        <package android:name="com.dts.freefireth" />
        <package android:name="com.dts.freefiremax" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FFBoostX">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FFBoostX"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Hosts the HUD and crosshair windows. specialUse is the correct type:
            an overlay is not location, media, camera or any other defined
            category. It is never sticky, so Android killing it leaves the
            overlay down rather than bringing it back over an unrelated app.
        -->
        <service
            android:name=".overlay.GamingOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Draws a gaming HUD and crosshair over the running game and takes
                    them down when the session ends." />
        </service>

        <!--
            Local VpnService that drops other apps' traffic while you play. It
            never reads, forwards or logs a packet and contacts no server; the
            tunnel is established and then left alone.
        -->
        <service
            android:name=".overlay.MacroAccessibilityService"
            android:exported="false"
            android:label="FF BoostX Macro Engine"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/macro_accessibility_service" />
        </service>

        <service
            android:name=".overlay.BackgroundNetworkBlocker"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
